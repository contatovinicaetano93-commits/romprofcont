# Copie este arquivo para `.env.local` e preencha os valores.

# --- Banco de dados (obrigatório) ---
# Connection string do Neon (modo pooled). Console: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# --- Autenticação (obrigatório) ---
# Segredo para assinar o JWT de sessão. Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# --- Cron de e-mail (obrigatório em produção) ---
# Bearer usado pelo cron da Vercel em GET /api/cron/sync-email. Gere com: openssl rand -hex 24
CRON_SECRET="troque-por-um-segredo-aleatorio"

# --- Integração IMAP (opcional; necessário para o sync de e-mail) ---
IMAP_HOST="email-ssl.com.br"
IMAP_PORT="993"
IMAP_USER="impostoparceiro@romconcept.com.br"
IMAP_PASSWORD=""
IMAP_MAX_PER_RUN="20"

# --- Assistente IA (opcional) ---
# Modelo usado em /api/assistente/chat (padrão: openai/gpt-4o-mini)
# AI_MODEL="openai/gpt-4o-mini"
